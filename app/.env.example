# Set one key. Without a key the desk uses the committed triage cache and the live button reports "no live model".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider (anthropic | openai | stub) and model name.
# Use an API account with zero-retention / no-training terms (DECISIONS D16).
TRIAGE_PROVIDER=
TRIAGE_MODEL=
